{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gym-erp-backend",
      "runtimeExecutable": "backend/venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "8000"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "gym-erp-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host",
        "localhost"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
