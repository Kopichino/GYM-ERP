VITE_API_URL=http://localhost:8000/api

# Which gym this frontend serves: the slug the API expects in /api/t/<slug>/...
# Required in production (set it in Vercel's environment variables): a wrong or
# missing value sends every gym request to a gym that does not exist, and they
# all 404. Read the real one from the database, never guess it:
#   SELECT slug, name FROM tenancy_tenant ORDER BY id;
# A database created fresh from the migrations starts with `default-gym-main`,
# which is the value below. Left unset, the frontend falls back to
# `ironcore-main` -- the gym on local databases seeded before multi-tenancy.
VITE_TENANT_SLUG=default-gym-main
