# Copy this file to .env for local development.
# In production (Render), set these as real environment variables instead --
# do not deploy a .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to fall back to SQLite. In production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary (free tier) -- required for media uploads to work in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (free tier, optional) -- leave blank to disable
SENTRY_DSN=

TIME_ZONE=UTC
