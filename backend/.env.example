# Copy this file to .env for local development.
# In production (Render), set these as real environment variables instead --
# do not deploy a .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to fall back to SQLite. In production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary (free tier) -- required for media uploads to work in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (free tier, optional) -- leave blank to disable
SENTRY_DSN=

# Set this to the gym's real timezone in production -- check-in times, report
# date ranges and reminder windows are all read in local time.
TIME_ZONE=UTC

# --- Gym identity, printed on GST invoices ------------------------------
# The Branding page in the admin portal overrides these once it's filled in;
# these stay the fallback for a fresh install.
GYM_NAME=IRONCORE
GYM_GSTIN=
# Your own state. A sale to the same state splits into CGST + SGST; anywhere
# else is charged as IGST. Leave blank and invoices carry no place of supply.
GYM_STATE=
GST_RATE=18

# --- Outgoing member email ----------------------------------------------
# Leave EMAIL_HOST blank and mail is printed to the console instead of sent,
# so `manage.py send_reminders` is safe to run before SMTP is set up.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Online payments (Razorpay) -----------------------------------------
# Blank = the member portal doesn't offer online renewal at all.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Issued per webhook endpoint in the Razorpay dashboard -- not the API secret.
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Business (Meta Cloud API) ---------------------------------
# Blank = the WhatsApp tab is hidden, nothing is sent, the assistant is silent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chosen by you, then typed into Meta's dashboard; echoed back on subscription.
WHATSAPP_VERIFY_TOKEN=
# Meta's app secret. Without it every webhook is refused, which is the point.
WHATSAPP_APP_SECRET=

# --- Assistant fallback (optional) --------------------------------------
# Only used for WhatsApp questions the built-in matcher doesn't recognise, and
# only with facts already read from the database. Blank = no model call.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5

